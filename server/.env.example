PORT=3000
# SQLite file (default: server/data/immich-web.db)
# DB_PATH=../data/immich-web.db
# Path to the built SPA (default: web/build)
# WEB_BUILD_DIR=../../web/build

# --- Memory / on-demand workers (see src/gateway/pool.js) ---
# Seconds without traffic before a worker process is stopped (RAM freed). Per group:
#   web core timeline media upload admin realtime
# IDLE_SEC_UPLOAD=60
# IDLE_SEC_WEB=120
# V8 heap cap per worker in MB (the process is killed instead of growing past it):
# HEAP_MB_UPLOAD=96
# Images / ffmpeg jobs running at once inside one worker (1 = lowest RAM):
# MEDIA_JOBS=1
# SQLite page cache per process, KiB:
# SQLITE_CACHE_KB=1024
# Set to see per-worker memory at /api/health?token=<value>:
# STATUS_TOKEN=change-me

# Put groups that are used together into ONE process (saves ~20 MB per process that is not started).
# Measured while browsing: 115 MB -> 69 MB. Sets are joined with +, separate sets with a comma.
# GROUP_MERGE=core+timeline+media
# The gateway serves the web app itself (no extra process). Set to run it as its own worker instead:
# WEB_MODE=worker
