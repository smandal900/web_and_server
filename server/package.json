{
  "name": "immich-web-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express server for ImmichWeb - gateway + on-demand worker processes (low RAM)",
  "main": "src/index.js",
  "scripts": {
    "start": "node --max-old-space-size=48 --max-semi-space-size=1 --expose-gc src/index.js",
    "dev": "node --watch src/index.js",
    "start:single": "node src/single.js",
    "dev:single": "node --watch src/single.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "dependencies": {
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "thumbhash": "^0.1.1"
  }
}
